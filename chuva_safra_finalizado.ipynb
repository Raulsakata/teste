        "    url = f\"https://servicodados.ibge.gov.br/api/v1/localidades/estados/{codigo_uf}/municipios\"\n",
        "    dados = requisitar_json(url, timeout=20)\n",
        "    return {item['id']: item['nome'] for item in dados} if dados else {}\n",
        "\n",
