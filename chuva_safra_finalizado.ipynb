        "# Produtividade (quantidade produzida / área colhida)\n",
        "\n",
        "def calcular_produtividade(df):\n",
        "    df = df.copy()\n",
        "    df['produtividade'] = (df['quantidade_produzida'] / df['area_colhida'].replace(0, np.nan))\n",
        "\n",
        "    sem_area = df[\"produtividade\"].isna().sum()\n",
        "    print(f\"Área colhida ausente ou zero em {sem_area} de {len(df)} linha(s) — produtividade marcada como ausente.\")\n",
        "\n",
        "    return df\n",
        "\n",
        "df_merge = calcular_produtividade(df_merge)"
