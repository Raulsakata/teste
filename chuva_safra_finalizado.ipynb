        "---\n",
        "# PARTE 3 — Limpeza, Merge e Auditoria (Deyvison)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "bd783ff6",
      "metadata": {
        "id": "bd783ff6"
      },
      "source": [
        "### 3.1 Limpeza: tipos, municípios, códigos e valores ausentes"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "ea542413",
      "metadata": {
        "id": "ea542413"
      },
      "outputs": [],
      "source": [
        "def limpar_producao(df):\n",
        "    df = df.copy()\n",
        "    df['cod_municipio'] = df['cod_municipio'].astype(int)\n",
        "    df['ano'] = df['ano'].astype(int)\n",
        "    for col in ['quantidade_produzida', 'area_plantada', 'area_colhida']:\n",
        "        df[col] = pd.to_numeric(df[col], errors='coerce').fillna(0.0)\n",
        "    df['nome_municipio'] = df['nome_municipio'].fillna('Desconhecido')\n",
        "    return df\n",
        "\n",
        "\n",
        "def limpar_coordenadas(df):\n",
        "    df = df.copy()\n",
        "    df['cod_municipio'] = df['cod_municipio'].astype(int)\n",
        "    df['nome'] = df['nome'].astype(str).str.strip()\n",
        "    df['latitude'] = pd.to_numeric(df['latitude'], errors='coerce')\n",
        "    df['longitude'] = pd.to_numeric(df['longitude'], errors='coerce')\n",
        "    return df\n",
        "\n",
        "\n",
        "def limpar_chuva(df):\n",
        "    df = df.copy()\n",
        "    df['cod_municipio'] = df['cod_municipio'].astype(int)\n",
        "    df['ano'] = df['ano'].astype(int)\n",
        "    df['chuva_acumulada'] = pd.to_numeric(df['chuva_acumulada'], errors='coerce')\n",
        "    df['temperatura_media'] = pd.to_numeric(df['temperatura_media'], errors='coerce')\n",
        "    return df\n",
        "\n",
        "\n",
        "df_producao = limpar_producao(df_producao)\n",
        "df_coordenadas = limpar_coordenadas(df_coordenadas)\n",
        "df_chuva_safra = limpar_chuva(df_chuva_safra)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "6cf0bd72",
      "metadata": {
        "id": "6cf0bd72"
      },
      "source": [
        "### 3.2 Merge (produção + coordenadas + chuva) por `cod_municipio` + `ano`"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "2cf5749c",
      "metadata": {
        "id": "2cf5749c",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "3c3b54f4-d03f-428a-c912-fafba2d45b1a"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Merge validado: 7323 linhas.\n"
          ]
        }
      ],
      "source": [
        "duplicados_coord = df_coordenadas['cod_municipio'].duplicated().sum()\n",
        "if duplicados_coord:\n",
        "    raise ValueError(f\"municipio_coordenada tem {duplicados_coord} cod_municipio duplicado(s) — não é 1-para-1.\")\n",
        "\n",
        "try:\n",
        "    df_merge = df_producao.merge(\n",
        "        df_coordenadas[['cod_municipio', 'latitude', 'longitude']],\n",
        "        on='cod_municipio', how='left', validate='many_to_one', indicator='_com_coordenada'\n",
        "    )\n",
        "    df_merge = df_merge.merge(\n",
        "        df_chuva_safra[['cod_municipio', 'ano', 'chuva_acumulada', 'temperatura_media']],\n",
        "        on=['cod_municipio', 'ano'], how='left', validate='many_to_one', indicator='_com_clima'\n",
        "    )\n",
        "except pd.errors.MergeError as erro:\n",
        "    raise ValueError(f\"Cardinalidade incompatível no merge: {erro}\")\n",
        "\n",
        "assert len(df_merge) == len(df_producao), \"O merge alterou a quantidade de linhas da produção.\"\n",
        "print(f\"Merge validado: {len(df_merge)} linhas.\")\n"
      ]
    },
