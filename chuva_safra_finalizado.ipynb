    {
      "cell_type": "markdown",
      "source": [
        "##5.6 — Validação de Filtros nos Gráficos"
      ],
      "metadata": {
        "id": "cqm3kYYjlD-F"
      },
      "id": "cqm3kYYjlD-F"
    },
    {
      "cell_type": "code",
      "source": [
        "def validar_filtros_grafico(\n",
        "    fig,\n",
        "    df_origem,\n",
        "    produto_cod=None,\n",
        "    municipios=None,\n",
        "    ano_de=None,\n",
        "    ano_ate=None,\n",
        "    tipo_grafico=\"dispersao\",\n",
        "):\n",
        "    df_check = df_origem.copy()\n",
        "    if produto_cod is not None:\n",
        "        df_check = df_check[df_check[\"produto_cod\"] == produto_cod]\n",
        "    if municipios is not None:\n",
        "        df_check = df_check[df_check[\"cod_municipio\"].isin(municipios)]\n",
        "    if ano_de is not None:\n",
        "        df_check = df_check[df_check[\"ano\"] >= ano_de]\n",
        "    if ano_ate is not None:\n",
        "        df_check = df_check[df_check[\"ano\"] <= ano_ate]\n",
        "\n",
        "    pontos_figura = 0\n",
        "    n_traces_dados = 0\n",
        "\n",
        "    for trace in fig.data:\n",
        "        if tipo_grafico == \"ranking\" and trace.type == \"bar\":\n",
        "            pontos_figura += len(trace.x) if trace.x is not None else 0\n",
        "            n_traces_dados += 1\n",
        "        elif tipo_grafico in (\"dispersao\", \"evolucao\") and trace.type in (\"scatter\", \"scattergl\"):\n",
        "            is_tendencia = False\n",
        "            if hasattr(trace, \"line\") and trace.line is not None:\n",
        "                if getattr(trace.line, \"dash\", None) == \"dash\":\n",
        "                    is_tendencia = True\n",
        "            if not is_tendencia:\n",
        "                pontos_figura += len(trace.x) if trace.x is not None else 0\n",
        "                n_traces_dados += 1\n",
        "\n",
        "    match = False\n",
        "    detalhe = \"\"\n",
        "\n",
        "    if tipo_grafico == \"dispersao\":\n",
        "        df_check = df_check.dropna(subset=[\"chuva_acumulada\", \"produtividade\"])\n",
        "        match = len(df_check) == pontos_figura\n",
        "        detalhe = f\"esperado={len(df_check)}, figura={pontos_figura}\"\n",
        "    elif tipo_grafico == \"evolucao\":\n",
        "        df_check = df_check.dropna(subset=[\"produtividade\"])\n",
        "        n_anos = df_check[\"ano\"].nunique()\n",
        "        if n_traces_dados > 0:\n",
        "            pontos_por_trace = pontos_figura / n_traces_dados\n",
        "            match = abs(pontos_por_trace - n_anos) < 0.5\n",
        "            detalhe = f\"anos={n_anos}, traces={n_traces_dados}, pts/trace={pontos_por_trace:.1f}\"\n",
        "        else:\n",
        "            detalhe = \"nenhum trace de dados\"\n",
        "    elif tipo_grafico == \"ranking\":\n",
        "        df_check = df_check.dropna(subset=[\"produtividade\"])\n",
        "        n_mun = df_check.groupby([\"cod_municipio\", \"nome_municipio\"]).ngroups\n",
        "        match = n_mun >= pontos_figura\n",
        "        detalhe = f\"municípios_df={n_mun}, figura={pontos_figura}\"\n",
        "\n",
        "    return {\n",
        "        \"tipo_grafico\": tipo_grafico,\n",
        "        \"match\": match,\n",
        "        \"detalhe\": detalhe,\n",
        "        \"anos_unicos_df\": sorted(df_check[\"ano\"].unique().tolist()) if not df_check.empty else [],\n",
        "        \"municipios_unicos_df\": sorted(df_check[\"cod_municipio\"].unique().tolist()) if not df_check.empty else [],\n",
        "        \"produtos_unicos_df\": sorted(df_check[\"produto_cod\"].unique().tolist()) if not df_check.empty else [],\n",
        "    }"
      ],
