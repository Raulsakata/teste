        "    if municipios is not None:\n",
        "        df_ev = df_ev[df_ev[\"cod_municipio\"].isin(municipios)]\n",
        "    if ano_de is not None:\n",
        "        df_ev = df_ev[df_ev[\"ano\"] >= ano_de]\n",
        "    if ano_ate is not None:\n",
        "        df_ev = df_ev[df_ev[\"ano\"] <= ano_ate]\n",
        "\n",
        "    if metricas is None:\n",
        "        metricas = [\"produtividade\", \"chuva_acumulada\"] if perfil == \"tecnico\" else [\"produtividade\"]\n",
        "\n",
        "    agg_dict = {}\n",
        "    if \"produtividade\" in metricas:\n",
        "        agg_dict[\"produtividade_media\"] = (\"produtividade\", \"mean\")\n",
        "    if \"chuva_acumulada\" in metricas:\n",
        "        agg_dict[\"chuva_media\"] = (\"chuva_acumulada\", \"mean\")\n",
        "\n",
        "    df_hist = df_ev.groupby(\"ano\", as_index=False).agg(**agg_dict).sort_values(\"ano\")\n",
        "\n",
        "    if df_hist.empty:\n",
        "        fig = go.Figure()\n",
        "        fig.add_annotation(text=\"Sem dados para o período selecionado.\", xref=\"paper\", yref=\"paper\", showarrow=False)\n",
        "        return _aplicar_tema_figura(fig, perfil, cfg[\"altura\"])\n",
        "\n",
        "    fig = go.Figure()\n",
        "\n",
        "    if \"produtividade_media\" in df_hist.columns:\n",
        "        fig.add_trace(go.Scatter(\n",
        "            x=df_hist[\"ano\"], y=df_hist[\"produtividade_media\"],\n",
