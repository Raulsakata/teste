        "import requests\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import time\n",
        "import unicodedata\n",
        "import re\n",
        "import json\n",
        "import os\n",
        "import sqlite3\n",
        "from datetime import datetime\n",
        "from typing import Optional, Tuple, Dict, List\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "os.makedirs(\"dados_brutos\", exist_ok=True)\n",
        "os.makedirs(\"dados_tratados\", exist_ok=True)\n",
        "\n",
        "\n",
        "def requisitar_json(url, params=None, timeout=30, max_retries=3):\n",
        "    \"\"\"GET com retry e backoff exponencial. Retorna o JSON ou None se todas as tentativas falharem.\"\"\"\n",
        "    for tentativa in range(max_retries):\n",
        "        try:\n",
        "            resposta = requests.get(url, params=params, timeout=timeout)\n",
        "            resposta.raise_for_status()\n",
        "            return resposta.json()\n",
        "        except (requests.exceptions.RequestException, requests.exceptions.Timeout) as erro:\n",
        "            print(f\"Tentativa {tentativa + 1}/{max_retries} falhou ({url.split('?')[0]}): {erro}\")\n",
        "            time.sleep(2 * (tentativa + 1))\n",
        "    return None\n"
      ]
    },
