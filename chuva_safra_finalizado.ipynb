      "source": [
        "##5.5 — Gerador de Dashboard por Perfil"
      ],
      "metadata": {
        "id": "izn5cZodk6I5"
      },
      "id": "izn5cZodk6I5"
    },
    {
      "cell_type": "code",
      "source": [
        "def gerar_dashboard_perfil(\n",
        "    df,\n",
        "    perfil,\n",
        "    produto_cod=None,\n",
        "    municipios=None,\n",
        "    ano_de=None,\n",
        "    ano_ate=None,\n",
        "    salvar_json=True,\n",
        "    pasta_saida=\"dados_tratados/graficos\",\n",
        "):\n",
        "    os.makedirs(pasta_saida, exist_ok=True)\n",
        "    figuras = {}\n",
        "\n",
        "    fig_disp = grafico_dispersao(\n",
        "        df, perfil=perfil, produto_cod=produto_cod,\n",
        "        municipios=municipios, ano_de=ano_de, ano_ate=ano_ate\n",
        "    )\n",
        "    figuras[\"dispersao\"] = fig_disp\n",
        "    if salvar_json:\n",
        "        salvar_figura_json(fig_disp, f\"{pasta_saida}/{perfil}_dispersao.json\")\n",
        "\n",
        "    metricas = [\"produtividade\", \"chuva_acumulada\"] if perfil == \"tecnico\" else [\"produtividade\"]\n",
        "    fig_evo = grafico_evolucao(\n",
        "        df, perfil=perfil, produto_cod=produto_cod,\n",
        "        municipios=municipios, ano_de=ano_de, ano_ate=ano_ate, metricas=metricas\n",
        "    )\n",
        "    figuras[\"evolucao\"] = fig_evo\n",
        "    if salvar_json:\n",
        "        salvar_figura_json(fig_evo, f\"{pasta_saida}/{perfil}_evolucao.json\")\n",
        "\n",
        "    top_n = 10 if perfil == \"produtor\" else (20 if perfil == \"gestor\" else 15)\n",
        "    fig_rank = grafico_ranking(\n",
        "        df, perfil=perfil, produto_cod=produto_cod,\n",
        "        municipios=municipios, ano_de=ano_de, ano_ate=ano_ate, top_n=top_n\n",
        "    )\n",
        "    figuras[\"ranking\"] = fig_rank\n",
        "    if salvar_json:\n",
        "        salvar_figura_json(fig_rank, f\"{pasta_saida}/{perfil}_ranking.json\")\n",
        "\n",
        "    return figuras"
      ],
      "metadata": {
        "id": "T3yrxq29k90Z"
      },
