      "source": [
        "def evolucao_historica(df):\n",
        "\n",
        "  historico = (\n",
        "      df.groupby(\"ano\", as_index=False)\n",
        "      .agg(\n",
        "          produtividade_media=(\"produtividade\", \"mean\"),\n",
        "          chuva_media=(\"chuva_acumulada\",\"mean\"),\n",
        "          observacoes=(\"produtividade\", \"count\")\n",
        "      ).sort_values(\"ano\")\n",
        "  )\n",
        "\n",
        "  return historico\n",
        "\n",
        "historico = evolucao_historica(df_merge)"
      ],
