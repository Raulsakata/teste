      "source": [
        "### 4.6 Indicador de risco: definir fórmula, faixas e limites"
      ],
      "metadata": {
        "id": "KTG5soRF6cfq"
      },
      "id": "KTG5soRF6cfq"
    },
    {
      "cell_type": "code",
      "source": [
        "#Indicador de risco: definir fórmula, faixas e limites\n",
        "\n",
        "def calcular_risco(df):\n",
        "\n",
        "  df = df.copy()\n",
        "\n",
        "  mediana_prod = df[\"produtividade\"].median()\n",
        "  mediana_chuva = df[\"chuva_acumulada\"].median()\n",
        "\n",
        "  def risco(linha):\n",
        "\n",
        "    if pd.isna(linha[\"produtividade\"]) or pd.isna(linha[\"chuva_acumulada\"]):\n",
        "      return \"Sem dado\"\n",
        "\n",
        "    prod_baixa = linha[\"produtividade\"] < mediana_prod\n",
        "    chuva_baixa = linha[\"chuva_acumulada\"] < mediana_chuva\n",
        "\n",
        "    if prod_baixa and chuva_baixa:\n",
        "      return \"Alto\"\n",
        "\n",
        "    if prod_baixa or chuva_baixa:\n",
        "      return \"Médio\"\n",
        "\n",
        "    return \"Baixo\"\n",
        "\n",
        "  df[\"risco\"] = df.apply(risco, axis=1)\n",
        "\n",
        "  sem_dado = (df[\"risco\"] == \"Sem dado\").sum()\n",
        "  if sem_dado:\n",
        "    print(f\"{sem_dado} registro(s) sem dados suficientes para calcular o risco.\")\n",
        "\n",
        "  return df\n",
        "\n",
        "df_merge = calcular_risco(df_merge)"
      ],
      "metadata": {
