        "def filtrar_recorte(df, produto_cod=None, municipios=None, ano_de=None, ano_ate=None):\n",
        "    recorte = df.copy()\n",
        "\n",
        "    if produto_cod is not None:\n",
        "        recorte = recorte[recorte[\"produto_cod\"] == produto_cod]\n",
        "\n",
        "    if municipios is not None:\n",
        "        recorte = recorte[recorte[\"cod_municipio\"].isin(municipios)]\n",
        "\n",
        "    if ano_de is not None:\n",
        "        recorte = recorte[recorte[\"ano\"] >= ano_de]\n",
        "\n",
        "    if ano_ate is not None:\n",
        "        recorte = recorte[recorte[\"ano\"] <= ano_ate]\n",
        "\n",
        "    return recorte"
      ],
