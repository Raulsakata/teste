        "def grafico_dispersao(\n",
        "    df,\n",
        "    perfil=\"tecnico\",\n",
        "    produto_cod=None,\n",
        "    municipios=None,\n",
        "    ano_de=None,\n",
        "    ano_ate=None,\n",
        "    cor_por=\"risco\",\n",
        "    mostrar_tendencia=None,\n",
        "):\n",
        "    cfg = PERFIS_CONFIG[perfil]\n",
        "    filtros = _formatar_filtros(produto_cod, municipios, ano_de, ano_ate)\n",
        "\n",
        "    df_disp = df.copy()\n",
        "    if produto_cod is not None:\n",
        "        df_disp = df_disp[df_disp[\"produto_cod\"] == produto_cod]\n",
        "    if municipios is not None:\n",
        "        df_disp = df_disp[df_disp[\"cod_municipio\"].isin(municipios)]\n",
        "    if ano_de is not None:\n",
        "        df_disp = df_disp[df_disp[\"ano\"] >= ano_de]\n",
        "    if ano_ate is not None:\n",
        "        df_disp = df_disp[df_disp[\"ano\"] <= ano_ate]\n",
        "\n",
        "    df_disp = df_disp.dropna(subset=[\"chuva_acumulada\", \"produtividade\"])\n",
        "\n",
        "    if df_disp.empty:\n",
        "        fig = go.Figure()\n",
        "        fig.add_annotation(\n",
        "            text=\"Sem dados disponíveis para os filtros selecionados.\",\n",
        "            xref=\"paper\", yref=\"paper\", showarrow=False,\n",
        "            font=dict(size=16, color=\"gray\")\n",
        "        )\n",
        "        return _aplicar_tema_figura(fig, perfil, cfg[\"altura\"])\n",
        "\n",
        "    corr = df_disp[\"chuva_acumulada\"].corr(df_disp[\"produtividade\"])\n",
        "    z = np.polyfit(df_disp[\"chuva_acumulada\"], df_disp[\"produtividade\"], 1)\n",
        "    p = np.poly1d(z)\n",
        "\n",
        "    if cor_por == \"risco\":\n",
        "        cor_col = \"risco\"\n",
        "        cor_map = {\"Baixo\": \"#2E7D32\", \"Médio\": \"#F9A825\", \"Alto\": \"#C62828\", \"Sem dado\": \"#9E9E9E\"}\n",
        "        cat_orders = {\"risco\": [\"Baixo\", \"Médio\", \"Alto\", \"Sem dado\"]}\n",
        "    elif cor_por == \"ano\":\n",
        "        cor_col = \"ano\"\n",
        "        cor_map = None\n",
        "        cat_orders = None\n",
        "    else:\n",
        "        df_disp[\"produto_nome\"] = df_disp[\"produto_cod\"].map(PRODUTOS_NOME)\n",
        "        cor_col = \"produto_nome\"\n",
        "        cor_map = px.colors.qualitative.Set2\n",
        "        cat_orders = None\n",
        "\n",
        "    if perfil == \"produtor\":\n",
        "        hover = \"<b>%{customdata[0]}</b><br>Safra: %{customdata[1]}<br>Chuva: %{x:.0f} mm<br>Produtividade: %{y:.0f} kg/ha<extra></extra>\"\n",
        "        custom = df_disp[[\"nome_municipio\", \"ano\"]].values\n",
        "    elif perfil == \"tecnico\":\n",
        "        hover = \"<b>%{customdata[0]}</b> (%{customdata[1]})<br>Ano: %{customdata[2]}<br>Chuva: %{x:.1f} mm<br>Produtividade: %{y:.1f} kg/ha<br>Risco: %{customdata[3]}<extra></extra>\"\n",
        "        custom = df_disp[[\"nome_municipio\", \"produto_cod\", \"ano\", \"risco\"]].values\n",
        "    else:\n",
        "        hover = \"<b>%{customdata[0]}</b><br>Ano: %{customdata[1]}<br>Chuva: %{x:.0f} mm<br>Produtividade: %{y:.0f} kg/ha<extra></extra>\"\n",
        "        custom = df_disp[[\"nome_municipio\", \"ano\"]].values\n",
        "\n",
        "    fig = px.scatter(\n",
        "        df_disp,\n",
        "        x=\"chuva_acumulada\",\n",
        "        y=\"produtividade\",\n",
        "        color=cor_col,\n",
        "        color_discrete_map=cor_map if cor_map else None,\n",
