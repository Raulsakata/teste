        "def grafico_ranking(\n",
        "    df,\n",
        "    perfil=\"gestor\",\n",
        "    produto_cod=None,\n",
        "    municipios=None,\n",
        "    ano_de=None,\n",
        "    ano_ate=None,\n",
        "    top_n=15,\n",
        "    ordem=\"maiores\",\n",
        "):\n",
        "    cfg = PERFIS_CONFIG[perfil]\n",
        "    filtros = _formatar_filtros(produto_cod, municipios, ano_de, ano_ate)\n",
        "\n",
        "    df_rank = df.copy()\n",
        "    if produto_cod is not None:\n",
        "        df_rank = df_rank[df_rank[\"produto_cod\"] == produto_cod]\n",
        "    if municipios is not None:\n",
        "        df_rank = df_rank[df_rank[\"cod_municipio\"].isin(municipios)]\n",
        "    if ano_de is not None:\n",
        "        df_rank = df_rank[df_rank[\"ano\"] >= ano_de]\n",
        "    if ano_ate is not None:\n",
        "        df_rank = df_rank[df_rank[\"ano\"] <= ano_ate]\n",
        "\n",
        "    ranking = df_rank.groupby([\"cod_municipio\", \"nome_municipio\"], as_index=False).agg(\n",
        "        produtividade_media=(\"produtividade\", \"mean\"),\n",
        "        chuva_media=(\"chuva_acumulada\", \"mean\"),\n",
        "        observacoes=(\"produtividade\", \"count\"),\n",
        "    )\n",
        "    ranking = ranking.dropna(subset=[\"produtividade_media\"])\n",
        "\n",
        "    if ranking.empty:\n",
        "        fig = go.Figure()\n",
        "        fig.add_annotation(text=\"Sem dados para ranquear.\", xref=\"paper\", yref=\"paper\", showarrow=False)\n",
        "        return _aplicar_tema_figura(fig, perfil, cfg[\"altura\"])\n",
        "\n",
        "    ranking = ranking.sort_values(\"produtividade_media\", ascending=(ordem == \"menores\"))\n",
        "    if ordem == \"maiores\":\n",
        "        ranking = ranking.tail(top_n)\n",
        "    else:\n",
        "        ranking = ranking.head(top_n)\n",
        "    ranking = ranking.sort_values(\"produtividade_media\", ascending=True)\n",
        "\n",
        "    mediana_chuva = df_rank[\"chuva_acumulada\"].median()\n",
        "    mediana_prod = df_rank[\"produtividade\"].median()\n",
        "\n",
        "    def cor_barra(row):\n",
        "        prod_baixa = row[\"produtividade_media\"] < mediana_prod\n",
        "        chuva_baixa = row[\"chuva_media\"] < mediana_chuva\n",
        "        if prod_baixa and chuva_baixa:\n",
        "            return \"#C62828\"\n",
        "        if prod_baixa or chuva_baixa:\n",
        "            return \"#F9A825\"\n",
        "        return \"#2E7D32\"\n",
        "\n",
        "    ranking[\"cor\"] = ranking.apply(cor_barra, axis=1)\n",
        "\n",
        "    fig = go.Figure()\n",
        "    fig.add_trace(go.Bar(\n",
        "        y=ranking[\"nome_municipio\"],\n",
        "        x=ranking[\"produtividade_media\"],\n",
        "        orientation=\"h\",\n",
        "        marker_color=ranking[\"cor\"],\n",
        "        text=ranking[\"produtividade_media\"].round(1),\n",
        "        textposition=\"outside\",\n",
        "        hovertemplate=(\n",
        "            \"<b>%{y}</b><br>\"\n",
        "            \"Produtividade média: %{x:.1f} kg/ha<br>\"\n",
        "            \"Observações: %{customdata[0]}<extra></extra>\"\n",
        "        ),\n",
        "        customdata=ranking[[\"observacoes\"]].values,\n",
        "    ))\n",
        "\n",
        "    if perfil == \"produtor\":\n",
        "        titulo = f\"Onde minha produtividade se destaca<br><sup>{filtros['cultura']} | {filtros['periodo']}</sup>\"\n",
        "    elif perfil == \"tecnico\":\n",
        "        titulo = f\"Ranking Técnico de Produtividade<br><sup>{filtros['cultura']} | {filtros['periodo']} | Top {top_n}</sup>\"\n",
        "    else:\n",
        "        titulo = f\"Ranking Regional de Produtividade<br><sup>{filtros['cultura']} | {filtros['periodo']} | Top {top_n}</sup>\"\n",
        "\n",
        "    fig.update_layout(\n",
        "        title=dict(text=titulo, x=0.02, xanchor=\"left\"),\n",
        "        xaxis_title=\"Produtividade média (kg/ha)\",\n",
        "        yaxis_title=\"\",\n",
        "        barmode=\"group\",\n",
        "    )\n",
        "    return _aplicar_tema_figura(fig, perfil, cfg[\"altura\"])"
      ],
