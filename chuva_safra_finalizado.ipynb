        "def consultar_metadados_agregado(agregado):\n",
        "    \"\"\"Busca e salva os metadados (variáveis e produtos) de um agregado do SIDRA/IBGE.\"\"\"\n",
        "    dados_meta = requisitar_json(f\"https://servicodados.ibge.gov.br/api/v3/agregados/{agregado}/metadados\")\n",
        "    if not dados_meta:\n",
        "        print(f\"Não foi possível obter os metadados do agregado {agregado}.\")\n",
        "        return {}\n",
        "\n",
        "    with open(f\"dados_brutos/metadados_{agregado}_bruto.json\", \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(dados_meta, f, ensure_ascii=False, indent=2)\n",
        "\n",
        "    print(f\"--- Variáveis (agregado {agregado}) ---\")\n",
        "    for var in dados_meta.get(\"variaveis\", []):\n",
        "        print(f\"{var['id']}: {var['nome']} ({var['unidade']})\")\n",
        "\n",
        "    print(f\"--- Produtos (classificação 81, agregado {agregado}) ---\")\n",
        "    for classif in dados_meta.get(\"classificacoes\", []):\n",
        "        if classif[\"id\"] == 81:\n",
        "            for prod in classif.get(\"categorias\", []):\n",
        "                print(f\"{prod['id']}: {prod['nome']}\")\n",
        "    return dados_meta\n",
        "\n",
        "metadados_1612 = consultar_metadados_agregado(1612)  # lavouras temporárias\n",
        "metadados_1613 = consultar_metadados_agregado(1613)  # lavouras permanentes\n"
      ]
    },
