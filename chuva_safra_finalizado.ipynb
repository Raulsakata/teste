      "source": [
        "### 1.3 Coleta da produção agrícola\n",
        "\n",
        "A API do IBGE aceita vários anos e variáveis na mesma URL (separados por `|`) e vários\n",
        "produtos na mesma classificação (separados por `,`). Para não sobrecarregar o servidor\n",
        "com uma única URL enorme, pedimos poucos anos por vez (lotes de `tamanho_lote_anos`)."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "municipios_ce = buscar_nomes_municipios_ibge(23)\n",
        "print(f\"Municípios do Ceará: {len(municipios_ce)}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "rFgpg0gGNAwd",
        "outputId": "be3a5f0e-2dc9-49a6-c539-4e1ecd5a8ae3"
      },
      "id": "rFgpg0gGNAwd",
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Municípios do Ceará: 184\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "83b9cdf3",
      "metadata": {
        "id": "83b9cdf3"
      },
      "outputs": [],
      "source": [
        "def buscar_producao_ibge(\n",
        "    agregado,\n",
        "    produtos,\n",
        "    classificacao,\n",
        "    variaveis,\n",
        "    mapa_variaveis,\n",
        "    codigos_municipios,\n",
        "    anos=None,\n",
        "    tamanho_lote_anos=2\n",
        "):\n",
        "    \"\"\"Coleta dados municipais da PAM/SIDRA em lotes de anos.\"\"\"\n",
        "\n",
        "    anos = anos or [str(a) for a in range(2015, 2023)]\n",
        "    registros, brutos = [], []\n",
        "\n",
        "    # Ex.: N6[2300101,2300150,...]\n",
        "    localidades = \",\".join(map(str, codigos_municipios))\n",
        "\n",
        "    for inicio in range(0, len(anos), tamanho_lote_anos):\n",
        "        lote_anos = anos[inicio:inicio + tamanho_lote_anos]\n",
        "\n",
        "        url = (\n",
        "            f\"https://servicodados.ibge.gov.br/api/v3/agregados/{agregado}\"\n",
        "            f\"/periodos/{'|'.join(lote_anos)}\"\n",
        "            f\"/variaveis/{'|'.join(map(str, variaveis))}\"\n",
        "            f\"?localidades=N6[{localidades}]\"\n",
        "            f\"&classificacao={classificacao}[{','.join(map(str, produtos))}]\"\n",
        "        )\n",
        "\n",
        "        print(f\"Consultando agregado {agregado}, anos {lote_anos}...\")\n",
        "        dados = requisitar_json(url, timeout=90)\n",
        "\n",
        "        if not dados:\n",
        "            print(f\"Lote {lote_anos} falhou para o agregado {agregado}.\")\n",
        "            continue\n",
        "\n",
        "        brutos.append(dados)\n",
        "\n",
        "        for bloco in dados:\n",
        "            variavel_id = int(bloco.get(\"id\"))\n",
        "\n",
        "            for res_item in bloco.get(\"resultados\", []):\n",
        "                produto_id = None\n",
        "\n",
        "                for classif in res_item.get(\"classificacoes\", []):\n",
        "                    if str(classif.get(\"id\")) == str(classificacao):\n",
        "                        categoria = classif.get(\"categoria\") or {}\n",
        "                        if categoria:\n",
        "                            produto_id = int(next(iter(categoria)))\n",
        "\n",
        "                for serie in res_item.get(\"series\", []):\n",
        "                    cod_mun = serie.get(\"localidade\", {}).get(\"id\")\n",
        "\n",
        "                    for ano_str, valor in serie.get(\"serie\", {}).items():\n",
        "                        if cod_mun and produto_id and valor not in (None, \"-\", \"...\", \"x\", \"..\"):\n",
        "                            try:\n",
        "                                registros.append({\n",
        "                                    \"cod_municipio\": int(cod_mun),\n",
        "                                    \"ano\": int(ano_str),\n",
        "                                    \"produto_cod\": produto_id,\n",
        "                                    \"variavel_cod\": variavel_id,\n",
        "                                    \"valor\": float(valor),\n",
        "                                })\n",
        "                            except ValueError:\n",
        "                                pass\n",
        "\n",
        "    with open(\n",
        "        f\"dados_brutos/producao_{agregado}_bruto.json\",\n",
        "        \"w\",\n",
        "        encoding=\"utf-8\"\n",
        "    ) as f:\n",
        "        json.dump(brutos, f, ensure_ascii=False, indent=2)\n",
        "\n",
        "    if not registros:\n",
        "        return pd.DataFrame()\n",
        "\n",
        "    df = pd.DataFrame(registros)\n",
        "\n",
        "    df_pivot = (\n",
        "        df.pivot_table(\n",
        "            index=[\"cod_municipio\", \"ano\", \"produto_cod\"],\n",
        "            columns=\"variavel_cod\",\n",
        "            values=\"valor\",\n",
        "            aggfunc=\"first\",\n",
        "        )\n",
        "        .reset_index()\n",
        "    )\n",
        "\n",
        "    df_pivot.rename(columns=mapa_variaveis, inplace=True)\n",
        "\n",
        "    for coluna in mapa_variaveis.values():\n",
        "        if coluna not in df_pivot.columns:\n",
        "            df_pivot[coluna] = 0.0\n",
        "\n",
        "    df_pivot[\"agregado\"] = agregado\n",
        "    return df_pivot"
      ]
    },
