        "PRODUTOS_NOME = {\n",
        "    2711: \"Milho\", 2702: \"Feijão\", 2708: \"Mandioca\", 2692: \"Arroz\",\n",
        "    40473: \"Caju\", 2720: \"Banana\", 2727: \"Coco-da-Baía\"\n",
