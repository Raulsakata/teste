      "source": [
        "#Calcular correlação + contagem de observações válidas usadas\n",
        "\n",
        "def calcular_correlacao(df_dispersao):\n",
        "\n",
        "  dados = df_dispersao.dropna(subset=[\"chuva_acumulada\", \"produtividade\"])\n",
        "\n",
        "  return {\n",
        "      \"correlacao\" : float(dados[\"chuva_acumulada\"].corr(dados[\"produtividade\"])),\n",
        "      \"observacoes\" : len(dados)\n",
        "  }\n",
        "\n",
        "resultado_correlacao = calcular_correlacao(df_dispersao)\n",
        "\n",
        "print(resultado_correlacao)"
