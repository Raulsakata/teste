        "        \"mostrar_equacao\": False,\n",
        "        \"destaque_risco\": True,\n",
        "        \"altura\": 550,\n",
        "    },\n",
        "}\n",
        "\n",
        "\n",
        "def _formatar_periodo(anos: List[int]) -> str:\n",
        "    if len(anos) == 1:\n",
        "        return f\"Safra {anos[0]}\"\n",
        "    return f\"Safras {min(anos)}–{max(anos)}\"\n",
        "\n",
        "\n",
        "def _formatar_filtros(produto_cod=None, municipios=None, ano_de=None, ano_ate=None):\n",
        "    filtros = {}\n",
        "    if produto_cod is not None:\n",
        "        filtros[\"cultura\"] = PRODUTOS_NOME.get(produto_cod, f\"Cód. {produto_cod}\")\n",
        "    else:\n",
        "        filtros[\"cultura\"] = \"Todas as culturas\"\n",
        "\n",
        "    if municipios is not None and len(municipios) > 0:\n",
        "        if len(municipios) == 1:\n",
        "            filtros[\"municipio\"] = f\"Município {municipios[0]}\"\n",
        "        else:\n",
        "            filtros[\"municipio\"] = f\"{len(municipios)} municípios selecionados\"\n",
        "    else:\n",
        "        filtros[\"municipio\"] = \"Todos os municípios\"\n",
        "\n",
        "    anos = []\n",
        "    if ano_de is not None:\n",
        "        anos.append(ano_de)\n",
        "    if ano_ate is not None:\n",
        "        anos.append(ano_ate)\n",
        "    if anos:\n",
        "        filtros[\"periodo\"] = _formatar_periodo(list(range(min(anos), max(anos) + 1)))\n",
        "    else:\n",
        "        filtros[\"periodo\"] = \"Todos os períodos\"\n",
        "\n",
        "    return filtros\n",
        "\n",
        "\n",
        "def _aplicar_tema_figura(fig, perfil, altura):\n",
        "    cfg = PERFIS_CONFIG[perfil]\n",
        "    if perfil == \"produtor\":\n",
        "        cor_fonte = \"#2E4A28\"\n",
        "        cor_grid = \"#E8F5E9\"\n",
        "    elif perfil == \"tecnico\":\n",
        "        cor_fonte = \"#1A3A5C\"\n",
        "        cor_grid = \"#EBF5FB\"\n",
        "    else:\n",
        "        cor_fonte = \"#5D2E0F\"\n",
        "        cor_grid = \"#FFF3E0\"\n",
        "\n",
        "    fig.update_layout(\n",
        "        template=\"plotly_white\",\n",
        "        height=altura,\n",
        "        font=dict(family=\"Arial, sans-serif\", size=13, color=cor_fonte),\n",
        "        title_font=dict(size=18 if perfil == \"gestor\" else 16),\n",
        "        paper_bgcolor=\"white\",\n",
        "        plot_bgcolor=cor_grid,\n",
        "        legend=dict(\n",
        "            orientation=\"h\", yanchor=\"bottom\", y=-0.25, xanchor=\"center\", x=0.5,\n",
        "            bgcolor=\"rgba(255,255,255,0.8)\", bordercolor=cor_fonte, borderwidth=1\n",
        "        ),\n",
        "        margin=dict(l=60, r=40, t=80, b=80),\n",
        "    )\n",
        "    fig.update_xaxes(showgrid=True, gridwidth=1, gridcolor=\"rgba(0,0,0,0.05)\")\n",
        "    fig.update_yaxes(showgrid=True, gridwidth=1, gridcolor=\"rgba(0,0,0,0.05)\")\n",
        "    return fig"
