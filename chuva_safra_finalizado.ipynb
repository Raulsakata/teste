        "        category_orders=cat_orders,\n",
        "        opacity=0.75,\n",
        "        labels={\n",
        "            \"chuva_acumulada\": \"Chuva acumulada na quadra (mm)\",\n",
        "            \"produtividade\": \"Produtividade (kg/ha)\",\n",
        "            \"risco\": \"Nível de Risco\",\n",
        "            \"produto_nome\": \"Cultura\",\n",
        "        },\n",
        "    )\n",
        "\n",
        "    fig.update_traces(customdata=custom, hovertemplate=hover)\n",
        "\n",
        "    if (mostrar_tendencia if mostrar_tendencia is not None else cfg[\"mostrar_tendencia\"]):\n",
        "        x_trend = np.linspace(df_disp[\"chuva_acumulada\"].min(), df_disp[\"chuva_acumulada\"].max(), 100)\n",
