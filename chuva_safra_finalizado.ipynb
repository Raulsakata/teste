        "            mode=\"lines+markers\",\n",
        "            name=\"Chuva média (mm)\",\n",
        "            line=dict(color=\"#0288D1\", width=3, dash=\"dot\"),\n",
        "            marker=dict(size=10, symbol=\"circle\"),\n",
        "            yaxis=\"y2\",\n",
        "            hovertemplate=\"Ano: %{x}<br>Chuva: %{y:.1f} mm<extra></extra>\",\n",
