      "source": [
        "# KPIs\n",
        "\n",
        "def gerar_kpis(df):\n",
        "\n",
        "  df_dispersao = preparar_dispersao(df)\n",
        "  correlacao = calcular_correlacao(df_dispersao)\n",
        "\n",
        "  prod_media = df[\"produtividade\"].mean()\n",
        "  chuva_media = df[\"chuva_acumulada\"].mean()\n",
        "\n",
        "  corr = correlacao[\"correlacao\"]\n",
        "  if pd.isna(corr):\n",
        "      corr = None\n",
        "  else:\n",
        "      corr = round(corr, 3)\n",
        "\n",
        "\n",
        "  return {\n",
        "      \"total_municipios\": int(df[\"cod_municipio\"].nunique()),\n",
        "      \"total_culturas\": int(df[\"produto_cod\"].nunique()),\n",
        "      \"periodos\": int(df[\"ano\"].nunique()),\n",
        "      \"produtividade_media\": None if pd.isna(prod_media) else round(prod_media,2),\n",
        "      \"chuva_media\": None if pd.isna(chuva_media) else round(chuva_media,2),\n",
        "      \"correlacao\": corr,\n",
        "      \"observacoes\": int(correlacao[\"observacoes\"]),\n",
        "  }\n",
        "\n",
        "kpis = gerar_kpis(df_merge)\n",
        "\n",
        "print(kpis)"
