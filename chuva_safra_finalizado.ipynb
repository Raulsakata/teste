    {
      "cell_type": "code",
      "source": [
        "#Ranking de municípios (tratar empates e ausências)\n",
        "\n",
        "def ranking_municipios(df):\n",
        "\n",
        "  ranking = (\n",
        "      df.groupby([\"cod_municipio\", \"nome_municipio\"], as_index=False)\n",
        "      .agg(produtividade_media=(\"produtividade\",\"mean\"))\n",
        "  )\n",
        "\n",
        "  contem_dado = ranking[\"produtividade_media\"].notna()\n",
        "  ranking[\"ranking\"] = pd.NA\n",
        "  ranking.loc[contem_dado, \"ranking\"] = (\n",
        "      ranking.loc[contem_dado, \"produtividade_media\"].rank(ascending=False, method=\"dense\").astype(int)\n",
        "  )\n",
        "\n",
        "  sem_dado = (~contem_dado).sum()\n",
        "  if sem_dado:\n",
        "    print(f\"{sem_dado} municipio sem produtividade válida\")\n",
        "\n",
        "  return ranking.sort_values([\"ranking\", \"nome_municipio\"], na_position=\"last\")\n",
        "\n",
        "df_ranking = ranking_municipios(df_merge)"
      ],
      "metadata": {
