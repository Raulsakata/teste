        "mes_ini, mes_fim = definir_periodo_safra(\"quadra_chuvosa\")\n",
        "anos_analise = list(range(2015, 2023))\n",
        "municipios_validos = df_coordenadas.dropna(subset=['latitude', 'longitude'])\n",
        "\n",
        "clima_por_municipio = buscar_dados_climaticos_lote(\n",
        "    municipios_validos, f\"{anos_analise[0]}-01-01\", f\"{anos_analise[-1]}-12-31\"\n",
        ")\n",
        "\n",
        "blocos_chuva, falhas_cobertura = [], []\n",
        "for _, linha in municipios_validos.iterrows():\n",
        "    df_clima = clima_por_municipio.get(linha['cod_municipio'], pd.DataFrame())\n",
        "    df_agregado = agregar_chuva_safra(df_clima, anos_analise, mes_ini, mes_fim)\n",
        "    df_agregado['cod_municipio'] = linha['cod_municipio']\n",
        "    blocos_chuva.append(df_agregado)\n",
        "\n",
        "    anos_com_dado = set(df_agregado['ano'])\n",
        "    for ano in anos_analise:\n",
        "        if ano not in anos_com_dado:\n",
        "            falhas_cobertura.append({'cod_municipio': linha['cod_municipio'], 'nome': linha['nome'], 'ano': ano})\n",
        "\n",
        "df_chuva_safra = pd.concat(blocos_chuva, ignore_index=True) if blocos_chuva else \\\n",
        "    pd.DataFrame(columns=['ano', 'chuva_acumulada', 'temperatura_media', 'cod_municipio'])\n",
        "df_falhas_cobertura = pd.DataFrame(falhas_cobertura)\n",
        "\n",
        "df_chuva_safra.to_csv(\"dados_tratados/chuva_por_safra.csv\", index=False, encoding=\"utf-8\")\n",
        "df_falhas_cobertura.to_csv(\"dados_tratados/falhas_cobertura_clima.csv\", index=False, encoding=\"utf-8\")\n",
        "print(f\"Chuva agregada: {len(df_chuva_safra)} linhas | Falhas de cobertura: {len(df_falhas_cobertura)}\")\n",
        "df_chuva_safra.head()\n"
      ]
