        "def figura_para_json(fig, indent=2):\n",
        "    return json.dumps({\n",
        "        \"data\": fig.to_dict()[\"data\"],\n",
        "        \"layout\": fig.to_dict()[\"layout\"]\n",
        "    }, cls=PlotlyJSONEncoder, indent=indent, ensure_ascii=False)\n",
        "\n",
        "\n",
        "def salvar_figura_json(fig, caminho, indent=2):\n",
        "    with open(caminho, \"w\", encoding=\"utf-8\") as f:\n",
        "        f.write(figura_para_json(fig, indent=indent))\n",
        "    print(f\" Figura salva em: {caminho}\")"
      ],
      "metadata": {
        "id": "vDp3lsuak1l0"
      },
