        "---\n",
        "# PARTE 2 — Geocoding e Clima — Open-Meteo (Leandra)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "1573797a",
      "metadata": {
        "id": "1573797a"
      },
      "source": [
        "### 2.1 Normalização de nome do município"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "2c27a107",
      "metadata": {
        "id": "2c27a107",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "9010819e-c541-4765-857a-d61db8ba85c8"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "amontada ce\n"
          ]
        }
      ],
      "source": [
        "def normalizar_nome(texto):\n",
        "    if not texto:\n",
        "        return \"\"\n",
        "    texto = texto.lower().strip()\n",
        "    texto = unicodedata.normalize('NFD', texto)\n",
        "    texto = \"\".join(c for c in texto if unicodedata.category(c) != 'Mn')\n",
        "    texto = re.sub(r'[^a-z0-9\\s]', '', texto)\n",
        "    return re.sub(r'\\s+', ' ', texto).strip()\n",
        "\n",
        "print(normalizar_nome(\"Amontada (CE)\"))\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "670f1b4c",
      "metadata": {
        "id": "670f1b4c"
      },
      "source": [
        "### 2.2 Geocoding com validação de UF"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "149402e6",
      "metadata": {
        "id": "149402e6"
      },
      "outputs": [],
      "source": [
        "def buscar_coordenadas(nome_municipio, uf_esperada=\"Ceará\", max_retries=3):\n",
        "    \"\"\"Geocodifica um município via Open-Meteo, validando o estado (admin1) retornado.\"\"\"\n",
        "    params = {\"name\": nome_municipio, \"country\": \"BR\", \"count\": 10, \"language\": \"pt\"}\n",
        "    dados = requisitar_json(\"https://geocoding-api.open-meteo.com/v1/search\",\n",
        "                             params=params, timeout=10, max_retries=max_retries)\n",
        "\n",
        "    resultados = (dados or {}).get(\"results\", [])\n",
        "    if not resultados:\n",
        "        print(f\"'{nome_municipio}': não encontrado.\")\n",
        "        return None, None\n",
        "\n",
        "    for lugar in resultados:\n",
        "        estado = lugar.get(\"admin1\", \"\")\n",
        "        if uf_esperada.lower() in estado.lower() or \"cear\" in estado.lower():\n",
        "            return lugar[\"latitude\"], lugar[\"longitude\"]\n",
        "\n",
        "    print(f\"'{nome_municipio}': encontrado, mas fora de {uf_esperada} ({[l.get('admin1') for l in resultados]}).\")\n",
        "    return None, None\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "97222188",
      "metadata": {
        "id": "97222188"
      },
      "source": [
        "### 2.3 Cache de coordenadas (`municipio_coordenada`)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "d868f1ca",
      "metadata": {
        "id": "d868f1ca"
      },
      "outputs": [],
      "source": [
        "class GerenciadorCoordenadas:\n",
        "    \"\"\"Cache de coordenadas municipais para não geocodificar o mesmo município duas vezes.\"\"\"\n",
        "\n",
        "    def __init__(self, db_path=\"dados_tratados/municipio_coordenada.db\"):\n",
        "        self.db_path = db_path\n",
        "        os.makedirs(os.path.dirname(db_path), exist_ok=True)\n",
        "        with sqlite3.connect(self.db_path) as conn:\n",
        "            conn.execute(\"\"\"CREATE TABLE IF NOT EXISTS municipio_coordenada (\n",
        "                cod_municipio INTEGER PRIMARY KEY, nome TEXT NOT NULL, uf TEXT NOT NULL,\n",
        "                latitude REAL, longitude REAL, data_atualizacao TEXT)\"\"\")\n",
        "\n",
        "    def obter(self, cod_municipio):\n",
        "        with sqlite3.connect(self.db_path) as conn:\n",
        "            linha = conn.execute(\n",
        "                \"SELECT latitude, longitude FROM municipio_coordenada WHERE cod_municipio = ?\",\n",
        "                (cod_municipio,)\n",
        "            ).fetchone()\n",
        "        return {'latitude': linha[0], 'longitude': linha[1]} if linha else None\n",
        "\n",
        "    def salvar(self, cod_municipio, nome, uf, latitude, longitude):\n",
        "        with sqlite3.connect(self.db_path) as conn:\n",
        "            conn.execute(\n",
        "                \"\"\"INSERT OR REPLACE INTO municipio_coordenada\n",
        "                   (cod_municipio, nome, uf, latitude, longitude, data_atualizacao) VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n",
        "                (cod_municipio, nome, uf, latitude, longitude, datetime.now().isoformat())\n",
        "            )\n",
        "\n",
        "    def obter_ou_buscar(self, cod_municipio, nome, uf=\"Ceará\"):\n",
        "        cache = self.obter(cod_municipio)\n",
        "        if cache:\n",
        "            return cache\n",
        "        lat, lon = buscar_coordenadas(nome, uf_esperada=uf)\n",
        "        self.salvar(cod_municipio, nome, uf, lat, lon)\n",
        "        time.sleep(0.3)\n",
        "        return {'latitude': lat, 'longitude': lon} if lat is not None else None\n"
      ]
    },
